---
import MainGridLayout from '@layouts/MainGridLayout.astro'
import ArchivePanel from '@components/ArchivePanel.astro'
import ImageWrapper from '@components/misc/ImageWrapper.astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import path from 'path'
import { getSortedPosts } from '@utils/content-utils'
import { getDir, getPostUrlBySlug } from '@utils/url-utils'
import { i18n } from '@i18n/translation'
import I18nKey from '@i18n/i18nKey'

const posts = await getSortedPosts()

// 统计：文章数 / 标签数 / 分类数
const allTags = [...new Set(posts.flatMap(p => p.data.tags || []))].sort()
const allCategories = [...new Set(posts.map(p => p.data.category).filter(Boolean))]

// 无封面文章的默认封面池：assets/cover 下所有图片（注意本文件位于 src/pages/archive/，需上两级）
const coverPool = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/cover/*', { eager: true }),
)

// 兜底：封面池为空时使用「Simple Guides for Fuwari」的封面
const fallbackCover = {
  src: 'cover.jpeg',
  basePath: path.join('content/posts/', 'website/guide'),
}

// 固定种子洗牌（线性同余），让无封面文章按顺序领取互不相同的封面，且每次构建结果稳定
function shuffleSeeded<T>(arr: T[], seed: number): T[] {
  const a = [...arr]
  let s = seed || 1
  const rand = () => {
    s = (s * 1664525 + 1013904223) | 0
    return (s >>> 1) / 0x80000000
  }
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1))
    ;[a[i], a[j]] = [a[j], a[i]]
  }
  return a
}

const shuffledCovers = shuffleSeeded(coverPool, 20261112)
const coverBySlug = new Map<string, ImageMetadata>()
posts
  .filter(post => !post.data.image)
  .forEach((post, i) => {
    if (shuffledCovers.length > 0) {
      coverBySlug.set(post.slug, shuffledCovers[i % shuffledCovers.length].default)
    }
  })

function formatFullDate(date: Date) {
  const y = date.getFullYear()
  const month = (date.getMonth() + 1).toString().padStart(2, '0')
  const day = date.getDate().toString().padStart(2, '0')
  return `${y}-${month}-${day}`
}

let delay = 0
const interval = 50
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <!-- 标题 + 时间线/网格切换 -->
    <div class="card-base px-8 py-6 mb-4 flex items-end justify-between gap-4 onload-animation">
        <div>
            <h1 class="text-3xl font-bold text-90 transition mb-1">{i18n(I18nKey.archive)}</h1>
            <div class="text-black/40 dark:text-white/40 transition text-sm">Archive</div>
        </div>
        <div id="archive-view-switch" class="flex p-1 rounded-lg bg-black/5 dark:bg-white/10 transition">
            <button type="button" data-view="timeline"
                    class="archive-view-btn h-8 px-4 rounded-md text-sm font-medium transition text-black/50 dark:text-white/50">
                时间线
            </button>
            <button type="button" data-view="grid"
                    class="archive-view-btn h-8 px-4 rounded-md text-sm font-medium transition text-black/50 dark:text-white/50">
                网格
            </button>
        </div>
    </div>

    <!-- 统计：文章 / 标签 / 分类 -->
    <div class="grid grid-cols-3 gap-4 mb-4 onload-animation">
        <div class="card-base px-4 py-4 flex flex-col items-center gap-0.5">
            <Icon name="material-symbols:edit-note-outline-rounded" class="text-[1.9rem] text-[var(--primary)] mb-1"></Icon>
            <div class="text-sm text-black/50 dark:text-white/50 transition">文章</div>
            <div class="text-xl font-bold text-90 transition">{posts.length}</div>
        </div>
        <div class="card-base px-4 py-4 flex flex-col items-center gap-0.5">
            <Icon name="material-symbols:label-outline-rounded" class="text-[1.9rem] text-[var(--primary)] mb-1"></Icon>
            <div class="text-sm text-black/50 dark:text-white/50 transition">标签</div>
            <div class="text-xl font-bold text-90 transition">{allTags.length}</div>
        </div>
        <div class="card-base px-4 py-4 flex flex-col items-center gap-0.5">
            <Icon name="material-symbols:category-outline-rounded" class="text-[1.9rem] text-[var(--primary)] mb-1"></Icon>
            <div class="text-sm text-black/50 dark:text-white/50 transition">分类</div>
            <div class="text-xl font-bold text-90 transition">{allCategories.length}</div>
        </div>
    </div>

    <!-- 标签过滤 -->
    <div id="archive-tag-filter" class="card-base px-4 py-3 mb-4 flex flex-wrap gap-2 items-center onload-animation">
        <span class="text-sm font-bold text-black/40 dark:text-white/40 transition mr-1">标签筛选</span>
        <button type="button" data-tag="" class="archive-tag-chip current">全部</button>
        {allTags.map(tag => (
            <button type="button" data-tag={tag} class="archive-tag-chip">{tag}</button>
        ))}
    </div>

    <!-- 时间线视图 -->
    <div id="archive-timeline-view" class="onload-animation">
        <ArchivePanel></ArchivePanel>
    </div>

    <!-- 网格视图 -->
    <div id="archive-grid-view" class="hidden transition grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 onload-animation">
        {posts.map(post => (
            <a href={getPostUrlBySlug(post.slug)} aria-label={post.data.title}
               data-tags={(post.data.tags || []).join(',')}
               class="card-base group flex flex-col overflow-hidden rounded-[var(--radius-large)] transition hover:bg-[var(--btn-plain-bg-hover)] active:scale-[0.98] onload-animation"
               style={`animation-delay: calc(var(--content-delay) + ${(delay++) * interval}ms);`}
            >
                {post.data.image ? (
                    <ImageWrapper src={post.data.image} basePath={path.join('content/posts/', getDir(post.id))}
                                  alt={`Cover Image of ${post.data.title}`} class="w-full h-[9.5rem]">
                    </ImageWrapper>
                ) : coverBySlug.get(post.slug) ? (
                    <Image src={coverBySlug.get(post.slug)!} alt={`Cover Image of ${post.data.title}`}
                           class="w-full h-[9.5rem] object-cover" loading="lazy" data-random-cover />
                ) : (
                    <ImageWrapper src={fallbackCover.src} basePath={fallbackCover.basePath}
                                  alt={`Cover Image of ${post.data.title}`} class="w-full h-[9.5rem]">
                    </ImageWrapper>
                )}
                <div class="px-4 py-3 flex-1">
                    <div class="text-sm text-black/40 dark:text-white/40 transition mb-1 font-medium">
                        {formatFullDate(post.data.published)}
                    </div>
                    <div class="font-bold text-75 transition group-hover:text-[var(--primary)] line-clamp-2">
                        {post.data.title}
                    </div>
                </div>
            </a>
        ))}
    </div>

    <!-- 隐藏封面池：为客户端每次访问的随机分配提供已优化的图片地址（display:none + lazy 不产生下载） -->
    <div id="cover-pool" class="hidden" aria-hidden="true">
        {coverPool.map(cover => (
            <Image src={cover.default} alt="" width={640} loading="lazy" />
        ))}
    </div>
</MainGridLayout>

<!-- 视图切换逻辑见 Layout.astro 的 initArchiveViewSwitch（swup 导航时页面内联脚本不会执行） -->

<style>
#archive-view-switch .archive-view-btn.current {
    background: var(--btn-regular-bg);
    color: var(--btn-content);
}
/* 标签筛选小胶囊 */
.archive-tag-chip {
    height: 1.9rem;
    padding: 0 0.85rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(0, 0, 0, 0.12);
    transition: all 0.25s ease;
}
:root.dark .archive-tag-chip {
    color: rgba(255, 255, 255, 0.6);
    border-color: rgba(255, 255, 255, 0.16);
}
.archive-tag-chip:hover {
    border-color: var(--primary);
    color: var(--primary);
}
.archive-tag-chip.current {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
}
</style>
