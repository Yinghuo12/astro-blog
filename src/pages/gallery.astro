---
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { getCollection } from 'astro:content'
import ImageWrapper from '@components/misc/ImageWrapper.astro'
import { Icon } from 'astro-icon/components'
import path from 'node:path'

// 获取相册配置文件
const galleryEntries = await getCollection('gallery')

// 从所有配置文件中提取照片信息
const allPhotos = galleryEntries.flatMap(entry => {
  const photos = entry.data.photos || []
  const basePath = path.join('content/gallery/', entry.slug.split('/').slice(0, -1).join('/'))
  return photos.map(photo => ({
    ...photo,
    _entryPath: basePath,
    _index: Math.random().toString(36).substr(2, 9) // 唯一ID
  }))
})

// 过滤草稿
const visiblePhotos = allPhotos.filter(photo => !photo.draft)

// 按日期排序（最新的在前）
const sortedPhotos = visiblePhotos.sort((a, b) => {
  const dateA = a.date || new Date(0)
  const dateB = b.date || new Date(0)
  return dateB.valueOf() - dateA.valueOf()
})

// 按相册分组
const photosByAlbum = sortedPhotos.reduce((acc, photo) => {
  const album = photo.album || 'default'
  if (!acc[album]) {
    acc[album] = []
  }
  acc[album].push(photo)
  return acc
}, {} as Record<string, typeof sortedPhotos>)

// 获取所有相册名称
const albums = Object.keys(photosByAlbum).sort()

function albumLabel(album: string): string {
  return album === 'default' ? '未分类' : album
}
---

<MainGridLayout title="相册" description="记录生活中的美好瞬间">
  <div class="onload-animation">
    <!-- 页面头部 -->
    <div class="flex items-end justify-between gap-4 mb-4">
      <div>
        <h1 class="flex items-center font-bold text-2xl text-90 transition mb-1
                   before:w-1 before:h-6 before:rounded-md before:bg-[var(--primary)] before:mr-3">
            相册
        </h1>
        <p class="text-sm text-black/45 dark:text-white/45 transition pl-4">Gallery · 记录生活中的美好瞬间</p>
      </div>
      <div class="flex items-center gap-1.5 text-sm text-black/50 dark:text-white/50 transition shrink-0 pb-1">
        <Icon name="material-symbols:photo-library-outline-rounded" class="text-[1.35rem] text-[var(--primary)]"></Icon>
        {sortedPhotos.length} 张 · {albums.length} 个相册
      </div>
    </div>

    <!-- 相册过滤 -->
    {albums.length > 1 && (
      <div id="gallery-album-filter" class="flex flex-wrap gap-2 items-center mb-4">
        <span class="text-sm font-bold text-black/40 dark:text-white/40 transition mr-1">相册筛选</span>
        <button type="button" data-album="" class="gallery-album-chip current">全部</button>
        {albums.map(album => (
          <button type="button" data-album={album} class="gallery-album-chip">{albumLabel(album)}</button>
        ))}
      </div>
    )}

    <!-- 相册分区 -->
    {albums.length > 0 ? (
      <div class="space-y-7">
        {albums.map(album => (
          <div class="gallery-album-section" data-album={album}>
            <h2 class="flex items-center font-bold text-lg text-90 transition mb-3.5
                       before:w-0.5 before:h-4 before:rounded-full before:bg-[var(--primary)] before:mr-2.5">
                {albumLabel(album)}
                <span class="ml-2 px-2 py-0.5 rounded-full text-xs font-medium
                             bg-[var(--primary)]/10 text-[var(--primary)]">
                    {photosByAlbum[album].length} 张
                </span>
            </h2>

            <!-- 照片网格 -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5">
              {photosByAlbum[album].map((photo) => {
                return (
                  <div
                    class="gallery-photo group relative aspect-square overflow-hidden rounded-[var(--radius-large)] cursor-pointer transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5"
                    data-title={photo.title || ''}
                    data-description={photo.description || ''}
                    data-date={photo.date ? photo.date.toLocaleDateString('zh-CN') : ''}
                    data-location={photo.location || ''}
                    data-album={photo.album || 'default'}
                    data-image={photo.image}
                  >
                    <div class="absolute inset-0 transition-transform duration-500 group-hover:scale-[1.06]">
                      <ImageWrapper
                        src={photo.image}
                        basePath="content/gallery/images"
                        alt={photo.title || '照片'}
                        class="w-full h-full"
                      />
                    </div>
                    <!-- 悬停信息条：底部渐变 + 标题/地点 -->
                    <div class="absolute inset-x-0 bottom-0 top-1/2 bg-gradient-to-t from-black/75 to-transparent
                                 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                    <div class="absolute inset-x-0 bottom-0 p-3 pointer-events-none
                                 translate-y-1.5 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-300">
                      <div class="text-white text-sm font-bold truncate drop-shadow">
                        {photo.title || '未命名'}
                      </div>
                      <div class="flex items-center gap-1 text-[0.7rem] text-white/75 truncate drop-shadow mt-0.5">
                        {photo.location && (
                          <>
                            <Icon name="material-symbols:location-on-outline-rounded" class="text-[0.85rem]"></Icon>
                            <span class="truncate">{photo.location}</span>
                          </>
                        )}
                      </div>
                    </div>
                  </div>
                )
              })}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="card-base text-center py-14 text-black/50 dark:text-white/50">
        <div class="text-4xl mb-4">📷</div>
        <p>还没有照片，请在 content/gallery/images/ 文件夹下添加照片，并在 content/gallery/photos.md 中配置照片信息</p>
      </div>
    )}
  </div>
</MainGridLayout>

<style>
/* 相册筛选胶囊（与归档标签筛选同风格） */
.gallery-album-chip {
    height: 1.9rem;
    padding: 0 0.85rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(0, 0, 0, 0.12);
    transition: all 0.25s ease;
}
:root.dark .gallery-album-chip {
    color: rgba(255, 255, 255, 0.6);
    border-color: rgba(255, 255, 255, 0.16);
}
.gallery-album-chip:hover {
    border-color: var(--primary);
    color: var(--primary);
}
.gallery-album-chip.current {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
}
</style>
