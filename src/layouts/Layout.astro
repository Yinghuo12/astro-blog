function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		panelDom!.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

function initCustomScrollbar() {
	const bodyElement = document.querySelector('body');
	if (!bodyElement) return;
	// swup 每次内容替换都会调用本函数；对已初始化的目标重复 init 会破坏滚动，
	// 单参数调用可获取现有实例，存在则跳过
	if (OverlayScrollbars(bodyElement)) return;
	OverlayScrollbars(
		// docs say that a initialization to the body element would affect native functionality like window.scrollTo
		// but just leave it here for now
		{
			target: bodyElement,
			cancel: {
				nativeScrollbarsOverlaid: true,    // don't initialize the overlay scrollbar if there is a native one
			}
		}, {
		scrollbars: {
			theme: 'scrollbar-base scrollbar-auto py-1',
			autoHide: 'move',
			autoHideDelay: 500,
			autoHideSuspend: false,
		},
	});
	document.querySelectorAll('pre').forEach((ele) => {
		if (OverlayScrollbars(ele)) return;
		OverlayScrollbars(ele, {
			scrollbars: {
				theme: 'scrollbar-base scrollbar-dark px-2',
				autoHide: 'leave',
				autoHideDelay: 500,
				autoHideSuspend: false
			}
		});
	});
}

/* 归档页时间线/网格视图切换（swup 导航不执行页面内联脚本，因此常驻此处并在每次内容替换后重新初始化） */
function initArchiveViewSwitch() {
	const btns = document.querySelectorAll<HTMLElement>('#archive-view-switch .archive-view-btn');
	if (btns.length === 0) return;
	const timeline = document.getElementById('archive-timeline-view');
	const grid = document.getElementById('archive-grid-view');
	if (!timeline || !grid) return;

	const apply = (view: string, save: boolean) => {
		const isGrid = view === 'grid';
		grid.classList.toggle('hidden', !isGrid);
		timeline.classList.toggle('hidden', isGrid);
		btns.forEach(btn => btn.classList.toggle('current', btn.dataset.view === view));
		if (save) {
			try { localStorage.setItem('archive-view', view); } catch { /* ignore */ }
		}
	};

	let saved: string | null = null;
	try { saved = localStorage.getItem('archive-view'); } catch { /* ignore */ }
	apply(saved === 'grid' ? 'grid' : 'timeline', false);

	btns.forEach(btn => {
		btn.addEventListener('click', () => apply(btn.dataset.view || 'timeline', true));
	});
}

/* 透明导航：滚过 banner 后挂上 navbar-float 恢复磨砂卡片底，滚回 banner 内再变透明 */
function updateNavbarFloat() {
	const navbar = document.getElementById('navbar')
	if (!navbar || !navbar.classList.contains('navbar-transparent')) return
	const banner = document.getElementById('banner-wrapper')
	if (!banner) return
	const threshold = Math.max(0, banner.offsetHeight - navbar.offsetHeight)
	navbar.classList.toggle('navbar-float', window.scrollY > threshold)
}

let navbarFloatBound = false
function initNavbarFloat() {
	if (navbarFloatBound) return
	navbarFloatBound = true
	window.addEventListener('scroll', updateNavbarFloat, { passive: true })
	window.addEventListener('resize', updateNavbarFloat, { passive: true })
}

/* 归档页无封面文章：每次访问从封面池随机（不重复）重新分配，swup 导航后同样生效 */
function shuffleRandomCovers() {
	const pool = Array.from(document.querySelectorAll<HTMLImageElement>('#cover-pool img'))
	const targets = Array.from(document.querySelectorAll<HTMLImageElement>('[data-random-cover]'))
	if (pool.length === 0 || targets.length === 0) return
	for (let i = pool.length - 1; i > 0; i--) {
		const j = Math.floor(Math.random() * (i + 1))
		;[pool[i], pool[j]] = [pool[j], pool[i]]
	}
	targets.forEach((img, i) => {
		const source = pool[i % pool.length]
		const src = source.getAttribute('src')
		const srcset = source.getAttribute('srcset')
		if (src) img.setAttribute('src', src)
		if (srcset) img.setAttribute('srcset', srcset)
	})
}

/* 首屏向下箭头：点击平滑滚动到 banner 之下（元素在 swup 容器外持久存在，需防重复绑定） */
function initBannerScrollDown() {
	const btn = document.getElementById('banner-scroll-down') as (HTMLElement & { __bound?: boolean }) | null
	if (!btn || btn.__bound) return
	btn.__bound = true
	btn.addEventListener('click', () => {
		const banner = document.getElementById('banner-wrapper')
		if (!banner) return
		window.scrollTo({ top: banner.offsetHeight, behavior: 'smooth' })
	})
}

/* 主页精选文章轮播：三卡同显，自动切换 + 箭头/点击侧边虚化卡（swup 导航后重新初始化，旧定时器先清理） */
let fcTimer: number | undefined

function initFeaturedCarousel() {
	const root = document.getElementById('featured-carousel')
	if (fcTimer) {
		window.clearInterval(fcTimer)
		fcTimer = undefined
	}
	if (!root) return
	const slides = Array.from(root.querySelectorAll<HTMLElement>('.fc-slide'))
	const dots = Array.from(root.querySelectorAll<HTMLElement>('.fc-dot'))
	if (slides.length === 0) return
	let current = 0

	const show = (idx: number) => {
		current = (idx + slides.length) % slides.length
		slides.forEach((s, i) => s.classList.toggle('fc-off', i !== current))
		dots.forEach((d, i) => d.classList.toggle('active', i === current))
	}
	const restart = () => {
		if (fcTimer) window.clearInterval(fcTimer)
		fcTimer = window.setInterval(() => show(current + 1), 5000)
	}

	// 圆点直达
	dots.forEach((d) => {
		d.addEventListener('click', () => {
			show(Number(d.dataset.index || 0))
			restart()
		})
	})
	// 左右箭头切换
	root.querySelector('#fc-prev')?.addEventListener('click', () => {
		show(current - 1)
		restart()
	})
	root.querySelector('#fc-next')?.addEventListener('click', () => {
		show(current + 1)
		restart()
	})
	show(0)
	restart()
}

/* 归档页标签过滤：按标签隐藏时间线条目/网格卡片，空年份分组整体隐藏（swup 导航后重新初始化） */
function initArchiveTagFilter() {
	const filter = document.getElementById('archive-tag-filter')
	if (!filter) return
	const chips = Array.from(filter.querySelectorAll<HTMLElement>('.archive-tag-chip'))

	const apply = (tag: string) => {
		document.querySelectorAll<HTMLElement>('#archive-timeline-view [data-tags], #archive-grid-view [data-tags]').forEach(el => {
			const tags = (el.dataset.tags || '').split(',').filter(Boolean)
			el.classList.toggle('hidden', !!tag && !tags.includes(tag))
		})
		document.querySelectorAll<HTMLElement>('#archive-timeline-view .archive-year-group').forEach(group => {
			const visible = Array.from(group.querySelectorAll('[data-tags]')).some(el => !el.classList.contains('hidden'))
			group.classList.toggle('hidden', !visible)
		})
		chips.forEach(c => c.classList.toggle('current', (c.dataset.tag || '') === tag))
	}

	chips.forEach(c => {
		c.addEventListener('click', () => apply(c.dataset.tag || ''))
	})
	apply('')
}

/* 相册页相册过滤：按相册显示/隐藏照片分区（swup 导航后重新初始化） */
function initGalleryAlbumFilter() {
	const filter = document.getElementById('gallery-album-filter')
	if (!filter) return
	const chips = Array.from(filter.querySelectorAll<HTMLElement>('.gallery-album-chip'))
	const sections = Array.from(document.querySelectorAll<HTMLElement>('.gallery-album-section'))

	const apply = (album: string) => {
		sections.forEach(section => {
			section.classList.toggle('hidden', !!album && section.dataset.album !== album)
		})
		chips.forEach(c => c.classList.toggle('current', (c.dataset.album || '') === album))
	}

	chips.forEach(c => {
		c.addEventListener('click', () => apply(c.dataset.album || ''))
	})
	apply('')
}

function init() {
	// disableAnimation()()		// TODO
	loadTheme();
	loadHue();
	initCustomScrollbar();
	initArchiveViewSwitch();
	initArchiveTagFilter();
	initGalleryAlbumFilter();
	initNavbarFloat();
	updateNavbarFloat();
	shuffleRandomCovers();
	initBannerScrollDown();
	initFeaturedCarousel();
}

/* Load settings when entering the site */
init();

/* Load settings before swapping */
/* astro:after-swap event happened before swap animation */
document.addEventListener('astro:after-swap', init);

const setup = () => {
	// TODO: temp solution to change the height of the banner
/*
	window.swup.hooks.on('animation:out:start', () => {
		const path = window.location.pathname
		const body = document.querySelector('body')
		if (path[path.length - 1] === '/' && !body.classList.contains('is-home')) {
			body.classList.add('is-home')
		} else if (path[path.length - 1] !== '/' && body.classList.contains('is-home')) {
			body.classList.remove('is-home')
		}
	})
*/
	// Remove the delay for the first time page load
	window.swup.hooks.on('link:click', () => {
		document.documentElement.style.setProperty('--content-delay', '0ms')
	})
	window.swup.hooks.on('content:replace', initCustomScrollbar)
	window.swup.hooks.on('content:replace', initArchiveViewSwitch)
	window.swup.hooks.on('content:replace', updateNavbarFloat)
	window.swup.hooks.on('content:replace', shuffleRandomCovers)
	// smoothScrolling(ScrollPlugin) 与本站滚动冲突会锁死页面，已禁用；导航后的回顶由这里接管
	window.swup.hooks.on('content:replace', () => {
		window.scrollTo(0, 0)
	})
	window.swup.hooks.on('visit:start', (visit: {to: {url: string}}) => {
		// change banner height immediately when a link is clicked
		const bodyElement = document.querySelector('body')
		if (pathsEqual(visit.to.url, url('/'))) {
			bodyElement!.classList.add('is-home');
		} else {
			bodyElement!.classList.remove('is-home');
		}
	});

}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

</script>

<script>
import PhotoSwipeLightbox from "photoswipe/lightbox"
import "photoswipe/style.css"

let lightbox: PhotoSwipeLightbox
let pswp = import("photoswipe")

function createPhotoSwipe() {
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswp,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

const setup = () => {
	if (!lightbox) {
		createPhotoSwipe()
	}
	window.swup.hooks.on("page:view", () => {
		createPhotoSwipe()
	})

	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
		},
		{ before: true },
	)
}

if (window.swup) {
	setup()
} else {
	document.addEventListener("swup:enable", setup)
}
</script>


